{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toolbit",
  "version": "0.1.0",
  "identifier": "app.toolbit.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../../Web/web run dev:desktop",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../../Web/web run build:desktop && node scripts/prune-dist.mjs",
    "frontendDist": "../../../Web/web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Toolbit",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: wss:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first developer utilities",
    "longDescription": "Toolbit runs JSON, YAML, XML, SQL, encoding, hashing, time and network utilities entirely on this machine. Inputs and results stay in memory.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["txt", "json", "csv", "xml", "log", "md", "yaml", "yml"],
        "name": "Text file",
        "description": "Text file to open in Toolbit",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
